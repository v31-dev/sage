# Local development (docker-compose.yml). Deploying the published image is described
# in the README.

# Tailscale auth key for the dev manager's own tailnet node. Create it tagged (the tag
# becomes the manager's tag, e.g. tag:manager-dev) and not ephemeral. Only used while
# the node has no tailnet identity yet (first boot, lost state).
TS_AUTH_KEY=
# The dev manager's tailnet machine name, also its name inside Sage.
TS_NAME=
# Encrypts secrets and backups: openssl rand -base64 32 | tr '+/' '-_'
# Can't change after the first boot; to use another key, wipe SAGE_DATA first.
ENCRYPTION_KEY=
# Host directory mounted at /app/data (git-ignored).
SAGE_DATA=./data-gitignore
