{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Attach to dev manager",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "${input:sageHost}",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "sageHost",
      "type": "promptString",
      "description": "Dev manager address: its TS_NAME on the tailnet, or <TS_NAME>.<domain>",
      "default": "sage"
    }
  ]
}
